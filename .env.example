# ── Required ────────────────────────────────────────────────────────────────
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Cache TTL (seconds, 0 = disabled) ───────────────────────────────────────
FORWARD_RESOLVE_CACHE_EXPIRY=300
REVERSE_RESOLVE_CACHE_EXPIRY=1800

# ── Limits ( Maximum bulk reverse resolve requests ) ───────────────────────────────────────────────────────────────────
MAX_BULK_REVERSE_REQUEST=20

# ── Features ─────────────────────────────────────────────────────────────────
ENABLE_DOCS=false
DEBUG_MODE=false

# ── Testnet (optional) ────────────────────────────────────────────────────────
# IS_TESTNET=true

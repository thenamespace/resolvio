MAIN_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# Comma-separated, tried in order when the main RPC fails
FALLBACK_RPC_URLS=

FORWARD_RESOLVE_CACHE_EXPIRY=300
REVERSE_RESOLVE_CACHE_EXPIRY=1800
# Min seconds between noCache refreshes / cache clears of the same entry
MIN_CACHE_REFRESH_INTERVAL=5

MAX_BULK_REVERSE_REQUEST=20
MAX_BULK_PROFILE_REQUEST=20

ENABLE_DOCS=false
DEBUG_MODE=false
